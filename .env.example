# Catalogue AI — every knob, documented.
# Copy to .env and edit. Values here are the LOCAL DEFAULTS; the api refuses to
# start if a secret still contains a placeholder (CHANGE_ME / REPLACE_WITH_SHA256_HEX).

# ---- PostgreSQL ----
DATABASE_URL=postgres://catalogue:catalogue@localhost:5432/catalogue?sslmode=disable

# ---- Go API ----
HTTP_ADDR=:8080
MODEL_SERVER_URL=http://localhost:8090
# Shared secret for the model server's /v1 routes. Empty disables the check
# (dev only) — set it to a real value anywhere reachable from a network.
MODEL_SHARED_SECRET=local-model-secret
ASSET_STORAGE_DIR=/data/assets
ASSET_PUBLIC_BASE_URL=/assets
MODEL_TIMEOUT_SHORT=5s
# Generation composes against the model server; keep this above the 40s
# MODEL_TIMEOUT_SHORT so long drafts are not cut off.
MODEL_TIMEOUT_LONG=60s
WORKER_POLL_INTERVAL=2s
# How long a resolved API-key role is memoised. Bounds how long a revoked key
# keeps working, and how much database load auth costs.
AUTH_CACHE_TTL=30s
LOG_LEVEL=info
# Where the migration runner reads *.sql from. Relative to the process cwd, or
# an absolute path in the image (/db/migrations).
MIGRATIONS_DIR=db/migrations
# How long the api waits for Postgres at boot before giving up. Compose gates the
# api on a health check, but a check can pass marginally before the server
# accepts TCP; without a retry that race kills the container permanently.
DB_RETRY_BUDGET=2m
# Bootstrap API keys (name:sha256hex:role) — the DB `api_keys` table is
# authoritative; this is for first boot / local dev. Generate with:
#   python3 -c "import hashlib;print(hashlib.sha256(b'MY-SECRET').hexdigest())"
# Defaults below are the three dev roles, so role enforcement is testable:
#   admin  = local-dev-admin-key
#   editor = local-dev-editor-key
#   viewer = local-dev-viewer-key
BOOTSTRAP_API_KEYS=local-admin:6f7593f48eb57fc679c0b173ee15f27ea20f32b92d146e414327218a079ab479:admin,local-editor:c83926d81cad00e46578cfc12a35e36fc9d20de2468c843831fc53635b6ab983:editor,local-viewer:30349f7afd041a94444a542bf979896d7d740cf90efe64c4d55571653f5c8ec4:viewer

# ---- Model server (Python) ----
# Which model-server image `make up` builds.
#   deploy/docker/Dockerfile.model      3.8 GB CUDA image (production serving)
#   deploy/docker/Dockerfile.model-cpu  small, no GPU — required on machines
#                                       without an NVIDIA GPU, and what CI uses
MODEL_DOCKERFILE=deploy/docker/Dockerfile.model-cpu
# cuda | cpu (cpu allowed for tests/dev)
MODEL_DEVICE=cuda
TEXT_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
IMAGE_MODEL_NAME=openai/clip-vit-base-patch32
DESC_MODEL_DIR=ml/checkpoints/t5-description
PROJECTION_PATH=ml/checkpoints/projection/projection.pt
EMBED_DIM=512
FAISS_INDEX_DIR=/data/faiss
# How often a dirty index is flushed to FAISS_INDEX_DIR. 0 disables autosave,
# which means a restart loses every vector — the index then has to be rebuilt
# by re-running ingest for all items.
FAISS_AUTOSAVE_SECS=30
ASSET_ROOT=/data/assets
TEXT_INDEX_WEIGHT=0.6
IMAGE_INDEX_WEIGHT=0.4
CITATION_SUPPORT_THRESHOLD=0.35
MAX_CHUNK_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
# Deterministic torch seed for beam search. Empty = unseeded.
MODEL_SEED=
# Only for tests/smoke: vectors are then meaningless, so /readyz reports
# degraded. Never set this in production.
EMBEDDER_BACKEND=

# ---- Web (Vite) ----
# Leave EMPTY in production: the SPA then calls /api/v1 same-origin and nginx
# reverse-proxies it. Set it only for `npm run dev` against a remote API.
VITE_API_BASE=
