# SolidJS web — static build behind nginx with SPA fallback.
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY --chmod=0444 web/package.json web/package-lock.json* ./
RUN npm install
COPY --chmod=0444 web/ .
RUN npm run build

FROM nginx:1.27-alpine
# 0555 and not 0444: the argument applies to the directories too, and a
# directory without the execute bit cannot be traversed — nginx then 404s the
# bundle and falls through to the SPA, yielding a blank page.
COPY --from=build --chmod=0555 /src/dist /usr/share/nginx/html
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
  listen 80;
  # busybox wget resolves `localhost` to ::1 first, so an IPv4-only listener made
  # the healthcheck fail while the server was in fact healthy.
  listen [::]:80;
  server_name _;
  root /usr/share/nginx/html;

  # Resolve the api upstream at request time rather than at startup. With a bare
  # proxy_pass nginx resolves the name once when it loads the config and exits
  # with "host not found in upstream" if the api is not up yet — so a web pod
  # scheduled before the api crash-loops instead of waiting for it.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream http://api:8080;

  # product-photo uploads served from the shared assets volume
  location /assets/ {
    alias /data/assets/;
  }

  # The SPA is built with an empty VITE_API_BASE, so it calls /api/v1
  # same-origin. Without this proxy every API call from the browser 404s.
  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;   # /qa/ask and /v1/generate are slow by design
    proxy_request_buffering off;
  }

  # The web container answers its own liveness probe locally…
  location = /healthz { access_log off; return 200 "ok\n"; }

  # …but readiness belongs to the api. Without this, /readyz falls through to
  # the SPA fallback and returns index.html, so the runbook's
  # `curl :8081/readyz` silently returned HTML instead of JSON.
  location = /readyz {
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
  }

  # SPA fallback (must stay last)
  location / {
    try_files $uri $uri/ /index.html;
  }
}
EOF
EXPOSE 80
